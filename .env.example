# ============================================================================
# 企业级 RAG 智能助手 — 环境变量示例
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，切勿提交。
# 本文件只允许出现变量名和占位示例值，不得出现任何真实密钥。
# ============================================================================

# ---- 应用 ----
APP_ENV=development
APP_NAME=enterprise-rag-assistant
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# 允许跨域访问后端的前端地址，逗号分隔；3001 用于 3000 被占用时的本地开发
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# ---- 安全 ----
# 生产环境请用 `openssl rand -hex 32` 生成后替换
JWT_SECRET=change-me-to-a-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- 数据库 ----
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ragdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://rag:change-me-local-only@localhost:5432/ragdb

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ============================================================================
# 模型 Provider（见 docs/DECISIONS.md ADR-0001）
# provider 取值：mock | openai_compatible
# 默认 mock：无需任何 API Key 即可运行测试与 CI。
# 接入真实模型时改为 openai_compatible 并填写 base_url / api_key / model。
# ============================================================================

# ---- 生成模型 ----
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ---- Embedding 模型 ----
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与所选 embedding 模型的真实维度一致；bge-m3 为 1024，mock 默认 1024
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# ---- 前端 ----
# 浏览器侧访问后端的地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
